{
  "name": "task-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-db.js",
    "db:demo": "node scripts/seed-demo.js",
    "test": "node --test",
    "check": "node --check src/app.js && node --check public/app.js",
    "configure": "node scripts/configure.js",
    "backup": "node scripts/backup.js",
    "report": "node scripts/export-report.js",
    "test:browser": "node scripts/browser-check.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mysql2": "^3.24.0"
  },
  "devDependencies": {
    "docx": "^9.5.1",
    "playwright": "^1.64.1"
  },
  "engines": {
    "node": ">=22"
  }
}
